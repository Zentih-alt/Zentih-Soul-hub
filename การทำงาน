-- ===================================================
-- ULTRA-SMOOTH CFRAME LOCK ENGINE (PURE HEARTBEAT)
-- ===================================================
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local LockEngine = {
    Enabled = false,
    Target = nil,            -- Target Model/BasePart
    Angle = "Behind",        -- "Behind", "Above", "Below"
    Distance = 7.5,          -- ระยะห่างจากเป้าหมาย
    Connections = {},
    LastSafeCFrame = nil
}

-- [1] ฟังก์ชันล้างแรงทางฟิสิกส์แบบสมบูรณ์
local function clearVelocity(character)
    if not character then return end
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

-- [2] คำนวณ CFrame เป้าหมายด้วย CFrame.lookAt
local function calculateGoalCFrame(targetHrp, angle, distance)
    local targetPos = targetHrp.Position

    if angle == "Above" then
        local myPos = targetPos + Vector3.new(0, distance, 0)
        return CFrame.lookAt(myPos, targetPos)
    elseif angle == "Below" then
        local myPos = targetPos - Vector3.new(0, distance, 0)
        return CFrame.lookAt(myPos, targetPos)
    else 
        -- Default: Behind
        local offset = CFrame.new(0, 0, distance)
        local targetRotation = targetHrp.CFrame - targetHrp.CFrame.Position
        return CFrame.new(targetPos) * targetRotation * offset
    end
end

-- [3] ฟังก์ชันดึง HumanoidRootPart ของเป้าหมายแบบยืดหยุ่น
local function getTargetRoot(target)
    if not target or not target:IsDescendantOf(workspace) then return nil end
    if target:IsA("BasePart") then return target end
    return target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("RootPart") or target:FindFirstChildOfClass("BasePart")
end

-- ===================================================
-- PUBLIC METHODS (การเรียกใช้งาน)
-- ===================================================

-- เริ่มระบบการล็อก
function LockEngine:Start()
    if self.Enabled then return end
    self.Enabled = true

    -- Loop 1: Heartbeat Lock (ประมวลผลตำแหน่งเรียลไทม์)
    self.Connections.Heartbeat = RunService.Heartbeat:Connect(function()
        if not self.Enabled then return end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- Freeze Velocity ทุกเฟรม
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        if self.Target then
            local tRoot = getTargetRoot(self.Target)
            if tRoot then
                local goalCFrame = calculateGoalCFrame(tRoot, self.Angle, self.Distance)
                hrp.CFrame = goalCFrame
                self.LastSafeCFrame = goalCFrame
            end
        elseif self.LastSafeCFrame then
            -- ถ้าเป้าหมายหายไปชั่วคราว ให้ล็อกไว้ที่จุดปลอดภัยล่าสุด
            hrp.CFrame = self.LastSafeCFrame
        end
    end)

    -- Loop 2: Stepped NoClip + Physical Clearance
    self.Connections.Stepped = RunService.Stepped:Connect(function()
        if not self.Enabled then return end
        local char = LocalPlayer.Character
        if char then
            clearVelocity(char)
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

-- หยุดระบบล็อก และคืนค่าฟิสิกส์ปกติ
function LockEngine:Stop()
    self.Enabled = false
    for name, conn in pairs(self.Connections) do
        if conn and conn.Disconnect then
            pcall(function() conn:Disconnect() end)
        end
    end
    self.Connections = {}
    
    local char = LocalPlayer.Character
    if char then
        clearVelocity(char)
    end
end

-- เปลี่ยนเป้าหมายแบบ Smooth (ตัดแรงเหวี่ยงทันทีที่สลับ)
function LockEngine:SetTarget(newTarget)
    if self.Target ~= newTarget then
        local char = LocalPlayer.Character
        if char then clearVelocity(char) end
        self.Target = newTarget
    end
end

-- ===================================================
-- ตัวอย่างการนำไปรันใช้งาน (USAGE EXAMPLE)
-- ===================================================
--[[
-- 1. เริ่มใช้งาน
LockEngine:Start()

-- 2. กำหนดระยะและมุมมอง
LockEngine.Angle = "Behind" -- "Behind" | "Above" | "Below"
LockEngine.Distance = 8

-- 3. กำหนดเป้าหมาย (ส่ง Model หรือ Part เข้าไปได้เลย)
local mob = workspace.Enemies:FindFirstChild("Bandit")
LockEngine:SetTarget(mob)

-- 4. เลิกใช้งาน
-- LockEngine:Stop()
--]]

return LockEngine
