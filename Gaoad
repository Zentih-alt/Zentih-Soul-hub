-- ตัวแปรระบบ Dumper
--------------------------------------------------------------------------------
local Config = {
    FileName = "GameDump_" .. tostring(game.PlaceId),
    RemoteSpyActive = false,
    LoggedRemotes = {}
}

local function safeWriteFile(filename, content)
    if writefile then
        local success, err = pcall(function()
            writefile(filename, content)
        end)
        if success then
            print("[Success] Saved file: workspace/" .. filename)
        else
            warn("[Error] Writefile failed: " .. tostring(err))
        end
    end
end

local function dumpHierarchy(serviceName)
    local service = game:GetService(serviceName)
    if not service then return "" end

    local function scanInstance(inst, indent)
        indent = indent or ""
        local str = indent .. "[-] " .. inst.Name .. " (" .. inst.ClassName .. ")\n"
        
        if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") or inst:IsA("BindableEvent") then
            str = indent .. "[REMOTE] " .. inst.Name .. " (" .. inst.ClassName .. ") Path: " .. inst:GetFullName() .. "\n"
        end

        for _, child in ipairs(inst:GetChildren()) do
            if string.len(indent) < 14 then
                str = str .. scanInstance(child, indent .. "  ")
            end
        end
        return str
    end

    return "=== SERVICE: " .. serviceName .. " ===\n" .. scanInstance(service) .. "\n\n"
end

