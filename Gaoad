-- ดักจับ Remote Event
local oldNamecall
if hookmetamethod then
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if Config.RemoteSpyActive and (method == "FireServer" or method == "InvokeServer") then
            local remotePath = self:GetFullName()
            local formattedArgs = ""
            for i, arg in ipairs(args) do
                formattedArgs = formattedArgs .. tostring(arg) .. (i < #args and ", " or "")
            end
            
            local logEntry = string.format("[%s] game:%s:%s(%s)", os.date("%X"), remotePath, method, formattedArgs)
            table.insert(Config.LoggedRemotes, logEntry)
        end

        return oldNamecall(self, ...)
    end)
end

createButton(PageRemotes, "💾 เซฟ Remote Logs ลงไฟล์ (.txt)", Color3.fromRGB(60, 100, 180), function()
    if #Config.LoggedRemotes == 0 then return end
    local content = "=== RECORDED REMOTE EVENTS ===\n\n"
    for _, log in ipairs(Config.LoggedRemotes) do
        content = content .. log .. "\n"
    end
    safeWriteFile("RemoteLogs_" .. tostring(game.PlaceId) .. ".txt", content)
end)

createButton(PageRemotes, "🗑️ ล้างประวัติ Remote", Color3.fromRGB(120, 60, 60), function()
